# Copy to .env and fill in. .env is git-ignored.

# true = use built-in sample organizations, no Saviynt calls
MOCK_MODE=false

# Tenant base URL, without /ECM (the Postman {{url}} variable)
SAVIYNT_URL=https://your-tenant.saviyntcloud.com
# The Postman {{path}} variable
SAVIYNT_API_PATH=api/v5

# Service account used by the form's backend
SAVIYNT_USERNAME=
SAVIYNT_PASSWORD=

# Optional: limit which organizations the form offers, e.g.
# SAVIYNT_ORG_QUERY=c.parentorganization = 'External Partners'
SAVIYNT_ORG_QUERY=

# Which Saviynt user attribute stores the chosen organization on the request.
# Change to whatever attribute your approval workflow reads.
SAVIYNT_ORG_FIELD=customproperty1

# Optional: username recorded as the requestor on each request.
SAVIYNT_REQUESTOR=

# Which brand to show (file under brands/, without .json). Default: default
BRAND=default

PORT=3000
