# Copy to .env for docker compose (or local runs). .env is git-ignored.

# Admin console login (HTTP Basic). Change these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Set to true to run with built-in sample data and no Saviynt calls.
MOCK_MODE=false

# The Saviynt connection (URL, service account, etc.) is NOT set here.
# Configure it in the admin console at /admin; it is stored in data/config.json.

# PORT only applies to non-Docker local runs (Docker uses 3000 + the compose map).
PORT=3000
