# Copy to .env for docker compose, or paste these keys into your deployer's
# environment box (e.g. Cerebro's "Deploy stack" Environment). .env is
# git-ignored. No real secrets belong in this example file.

# Admin console login (HTTP Basic). Change these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Set to true to run with built-in sample data and no Saviynt calls.
MOCK_MODE=false

# Log verbosity: info (default) or debug. debug logs full Saviynt request and
# response bodies (passwords and tokens are redacted).
LOG_LEVEL=info

# Host port to publish the app on. Pick one that doesn't clash with other
# containers on the host. The app always listens on 3000 inside the container.
PORT=3000

# The Saviynt connection (tenant URL, service account, requestor, org
# attribute) is NOT set here. You add and edit it in the admin console at
# /admin, and it is stored on the "forms-data" volume so it survives redeploys.
